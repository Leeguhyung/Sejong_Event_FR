# 이 파일을 복사해 `.env.local`(개발) 또는 배포 플랫폼 환경변수로 설정한다.
# cp .env.example .env.local

# 백엔드 REST API 베이스 URL (끝에 /api 포함)
# - 로컬: 비워두면 http://localhost:8080/api 로 기본 동작
# - 배포: 배포된 백엔드 주소로 설정 (예: https://api.seq.example.com/api)
VITE_API_URL=http://localhost:8080/api

# 카카오맵 JavaScript 키 (부스 지도). 비워두면 지도 자리에 "지도를 불러올 수 없어요" 안내가 뜬다.
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 같은 앱의 플랫폼 > Web 에 http://localhost:5173 과 배포 도메인을 등록해야 동작한다.
VITE_KAKAO_MAP_API_KEY=
